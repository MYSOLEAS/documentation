          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/PaymentLink" } } }
          }
        ]
      },
      "PublicPaymentLinkApiResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/PaymentLink" } }
          }
        ]
      },
      "SubscriptionApiResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
