      },
      "SubscriptionListApiResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Subscription" } } }
          }
        ]
      },
      "SubscriptionDetailApiResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/SubscriptionDetail" } }
          }
        ]
