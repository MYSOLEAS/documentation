          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": { "data": { "$ref": "#/components/schemas/SubscriptionPayment" } }
          }
        ]
      },
      "SubscriptionPaymentListApiResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/SubscriptionPayment" } } }
          }
        ]
      },
      "SubscriberListApiResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Subscriber" } } }
          }
        ]
      },
      "ServiceListApiResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Service" } } }
          }
        ]
      },
      "CountryListApiResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
