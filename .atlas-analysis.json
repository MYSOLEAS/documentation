  "keyFeatures": [
    "API routing and load balancing",
    "Authentication and authorization (API keys, OAuth 2.0, JWT)",
    "Rate limiting and throttling policies",
    "Request and response transformation",
    "Traffic analytics and monitoring",
    "Plugin and middleware system",
    "Webhook event notifications",
    "Multi-environment support (development, staging, production)",
    "Consumer management and access control"
  ],
  "publicApiSurface": [
    "GET /gateways — list all gateways",
    "POST /gateways — create a gateway",
    "GET /gateways/{id} — get gateway details",
    "PUT /gateways/{id} — update a gateway",
    "DELETE /gateways/{id} — delete a gateway",
    "GET /gateways/{id}/routes — list routes",
    "POST /gateways/{id}/routes — create a route",
    "GET /routes/{id} — get route details",
    "PUT /routes/{id} — update a route",
    "DELETE /routes/{id} — delete a route",
    "GET /consumers — list consumers",
    "POST /consumers — create a consumer",
    "GET /consumers/{id}/api-keys — list API keys for a consumer",
    "POST /consumers/{id}/api-keys — create an API key"
  ]
}
